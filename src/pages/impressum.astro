---
import Base from '../layouts/Base.astro';
---

<Base title="Impressum — mThreeD.iO">
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-12">
    <h1 class="text-3xl font-bold mb-8">Impressum</h1>
    <div class="space-y-4 text-io-muted">
      <p>Angaben gemäß § 5 DDG:</p>
      <p class="text-io-text">
        Sebastian Hartmann<br />
        Pirna, Sachsen
      </p>
      <p>
        Kontakt: <a href="mailto:beta@mthreed.io" class="text-io-green hover:underline">beta@mthreed.io</a>
      </p>
      <p class="rounded border border-io-border bg-io-panel p-4 text-sm">
        Diese Seite befindet sich im Beta-Aufbau. Das vollständige Impressum
        (ladungsfähige Anschrift, Rechtsform) wird vor dem öffentlichen Start ergänzt.
      </p>
    </div>
  </section>
</Base>
